#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED="$(readlink -f "$SCRIPT_PATH" 2>/dev/null || true)"
  if [[ -n "$RESOLVED" ]]; then
    SCRIPT_PATH="$RESOLVED"
  fi
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
APP_ROOT="${APP_ROOT:-$(cd -- "$SCRIPT_DIR/.." && pwd)}"
DEFAULT_CONFIG="${GUESTBOOK_CONFIG:-$APP_ROOT/config/config.toml}"

if [[ -f /etc/st33v-guestbook/config.toml ]]; then
  DEFAULT_CONFIG="${GUESTBOOK_CONFIG:-/etc/st33v-guestbook/config.toml}"
fi

export PYTHONPATH="$APP_ROOT${PYTHONPATH:+:$PYTHONPATH}"

if [[ " $* " == *" --config "* ]]; then
  exec python3 -m guestbook.admin "$@"
fi

exec python3 -m guestbook.admin --config "$DEFAULT_CONFIG" "$@"
